+
+/*
+ * Current Oplus Android 16 listener transactions. Check the final kernel
+ * buffer, not the caller's mutable userspace Parcel. This is a UID policy,
+ * not an implementation of Android package-signature permissions.
+ */
+static int binder_hans_listener_access(struct binder_transaction *t,
+				       struct binder_proc *target_proc,
+				       int reply)
+{
+	static const char interface[] = "com.oplus.app.IOplusHansFreezeManager";
+	/* StrictMode, WorkSource, header, then String16 length and text. */
+	enum { header_bytes = 4 * sizeof(__le32) };
+	u8 prefix[header_bytes + 2 * sizeof(interface)];
+	char comm[TASK_COMM_LEN];
+	unsigned int i;
+	int ret;
+
+	if (reply || (t->code != 3 && t->code != 4) ||
+	    uid_eq(t->sender_euid, KUIDT_INIT(1000)) ||
+	    !uid_eq(target_proc->cred->euid, KUIDT_INIT(1000)))
+		return 0;
+
+	get_task_comm(comm, target_proc->tsk);
+	if (strcmp(comm, "system_server") ||
+	    t->buffer->data_size < sizeof(prefix))
+		return 0;
+
+	ret = binder_alloc_copy_from_buffer(&target_proc->alloc, prefix,
+					   t->buffer, 0, sizeof(prefix));
+	if (ret)
+		return ret;
+	if (get_unaligned_le32(prefix + header_bytes - sizeof(__le32)) !=
+	    sizeof(interface) - 1)
+		return 0;
+	for (i = 0; i < sizeof(interface); i++) {
+		if (prefix[header_bytes + 2 * i] != interface[i] ||
+		    prefix[header_bytes + 2 * i + 1])
+			return 0;
+	}
+
+	return -EPERM;
 }
 
 static void binder_transaction(struct binder_proc *proc,
@@ -3894,6 +3939,15 @@
 		return_error_line = __LINE__;
 		goto err_copy_data_failed;
 	}
+	/* Objects and deferred copies are complete; nothing has been queued yet. */
