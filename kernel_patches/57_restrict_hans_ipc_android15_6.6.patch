+/* Called with the resolved listening socket's state lock held. */
+static int unix_hans_connect_access(struct sock *other)
+{
+	static const char name[] = "\0hans_socket_server";
+	const struct unix_address *addr;
+
+	if (uid_eq(current_euid(), KUIDT_INIT(1000)))
+		return 0;
+	addr = unix_sk(other)->addr;
+	if (addr->len == (int)(offsetof(struct sockaddr_un, sun_path) + sizeof(name) - 1) &&
+	    !memcmp(addr->name->sun_path, name, sizeof(name) - 1))
+		return -EACCES;
+
+	return 0;
+}
