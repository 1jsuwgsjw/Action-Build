+    for (i = 0; i < KSU_MANAGER_HASH_LENGTH; ++i)
+        hash[i] = tolower(entry.hash[i]);
+    hash[KSU_MANAGER_HASH_LENGTH] = '\0';
+    if (!ksu_check_apk_signature(path, entry.cert_size, hash))
+        return false;
