Subject: Verify dynamic managers against installed packages and retain forced state

Target: builtin 1cfa5734 after patches 12-17. Reuse the existing package
scanner, opening APKs after iterate_dir. Refresh verification on package
updates and after data is available, and rebind UIDs only after the stored
certificate matches. Serialize scans so an old scan cannot republish revoked
state. Reuse immutable forced values during reload rather than consuming
pending twice; the public IO toggle obeys the same force lock as SET.
No change to certificate lists, payload layouts or canonical manager rules.

diff --git a/kernel/extension/extension.c b/kernel/extension/extension.c
--- a/kernel/extension/extension.c
+++ b/kernel/extension/extension.c
@@ -359,6 +359,16 @@
 {
     return extension_id < KSU_EXTENSION_MAX &&
            test_bit(extension_id, extension_forced_mask);
+}
+
+/* Boot parameters are immutable after parsing; configuration reloads use
+ * this value without recursively entering the extension dispatcher. */
+bool ksu_extension_forced_value(u32 extension_id, u64 *value)
+{
+    if (!ksu_extension_is_forced(extension_id))
+        return false;
+    *value = extension_forced_values[extension_id];
+    return true;
 }
 
 int ksu_extension_ioctl(u32 extension_id, u32 caller_api_version, void __user *raw)
