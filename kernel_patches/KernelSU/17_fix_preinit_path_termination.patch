Subject: Terminate preinit path replacements explicitly

Target: builtin 1cfa5734 after patches 12-16. Copy the NUL even when the
/proc/self/fd path exceeds the original init pathname. Keep execution and
retry policy unchanged; fd 0 is also a valid descriptor in the post hook.

diff --git a/kernel/preinit/preinit.c b/kernel/preinit/preinit.c
--- a/kernel/preinit/preinit.c
+++ b/kernel/preinit/preinit.c
@@ -143,7 +143,7 @@
     path_put(&path);
 
     memset((void*)(*filename_ptr)->name, 0, strlen((*filename_ptr)->name));
-    memcpy((void*)(*filename_ptr)->name, (void*)fd_path, strlen(fd_path));
+    memcpy((void*)(*filename_ptr)->name, fd_path, len + 1);
 
     pr_info("preinit: exec runner via %s\n", fd_path);
     return fd;
@@ -153,10 +153,10 @@
                  void *argv_user, void *envp_user,
                  int *flags, int *retval, int *preinit_fd)
 {
-    if (*retval && *preinit_fd > 0) {
+    if (*retval && *preinit_fd >= 0) {
         ksu_close_fd_compat(*preinit_fd);
         memset((void*)(*filename_ptr)->name, 0, strlen((*filename_ptr)->name));
-        memcpy((void*)(*filename_ptr)->name, INIT_PATH, strlen(INIT_PATH));
+        memcpy((void*)(*filename_ptr)->name, INIT_PATH, sizeof(INIT_PATH));
         return -EINVAL;
     }
     return 0;
