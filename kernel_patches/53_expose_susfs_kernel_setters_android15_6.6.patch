+	info.err = susfs_set_uname_kernel(info.release, info.version);
 out_copy_to_user:
 	if (copy_to_user(&((struct st_susfs_uname __user*)*user_info)->err, &info.err, sizeof(info.err))) {
 		info.err = -EFAULT;
@@ -659,8 +663,8 @@
 
