+	if (copy_from_user(&info, (struct st_susfs_avc_log_spoofing __user*)*user_info, sizeof(info))) {
+		info.err = -EFAULT;
+		goto out_copy_to_user;
+	}
+
+	susfs_set_avc_log_spoofing_enabled(info.enabled);
 
 	info.err = 0;
