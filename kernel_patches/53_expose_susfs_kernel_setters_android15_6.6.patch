Subject: Share SUSFS state between legacy and manager kernel callers

Target: the pinned SUSFS v2.2.0 fs/susfs.c and susfs.h copied into common.
Extract typed, kernel-pointer helpers; legacy reboot wrappers retain their
user payloads and error copyout. Preserve the same static key, uname buffer,
seqlock and per-process hook scope. Honor all 64 UTS characters plus NUL.
No fabricated userspace pointers or new state copies.

diff --git a/fs/susfs.c b/fs/susfs.c
--- a/fs/susfs.c
+++ b/fs/susfs.c
@@ -614,6 +614,35 @@
 DEFINE_STATIC_KEY_FALSE(susfs_is_uname_spoof_buffer_set);
 static DEFINE_SEQLOCK(susfs_uname_seqlock);
 
+int susfs_set_uname_kernel(const char *release, const char *version) {
+	if (!*release || !*version)
+		return -EFAULT;
+	if (strnlen(release, sizeof(my_uname.release)) == sizeof(my_uname.release) ||
+		strnlen(version, sizeof(my_uname.version)) == sizeof(my_uname.version))
+		return -ENAMETOOLONG;
+
+	write_seqlock(&susfs_uname_seqlock);
+	if (!strcmp(release, "default")) {
+		strscpy(my_uname.release, utsname()->release, sizeof(my_uname.release));
+	} else {
+		strscpy(my_uname.release, release, sizeof(my_uname.release));
+	}
+	if (!strcmp(version, "default")) {
+		strscpy(my_uname.version, utsname()->version, sizeof(my_uname.version));
+	} else {
+		strscpy(my_uname.version, version, sizeof(my_uname.version));
+	}
+	write_sequnlock(&susfs_uname_seqlock);
+
+	if (!static_key_enabled(&susfs_is_uname_spoof_buffer_set))
+		static_branch_enable(&susfs_is_uname_spoof_buffer_set);
+
+	SUSFS_LOGI("set spoofed release: '%s', version: '%s'\n",
+				my_uname.release, my_uname.version);
+
+	return 0;
+}
+
 void susfs_set_uname(void __user **user_info) {
 	struct st_susfs_uname info = {0};
 
