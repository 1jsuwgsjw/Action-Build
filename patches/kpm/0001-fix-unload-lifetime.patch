+#define HOOK_GATE_CLOSED (1U << 31)
+#define HOOK_GATE_USERS (HOOK_GATE_CLOSED - 1U)
+
+/* A single atomic word closes the read-before-increment race. These helpers
+ * run in resident KernelPatch text, BEFORE a module function is fetched. */
+static __attribute__((always_inline)) inline int hook_callback_enter(uint32_t *gate)
+{
+    uint32_t value = __atomic_load_n(gate, __ATOMIC_RELAXED);
