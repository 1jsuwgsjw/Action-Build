+static struct module *module_get(const char *name, long *rc)
+{
+    unsigned long flags = spin_lock_irqsave(&module_lock);
+    struct module *mod = find_module(name);
+    *rc = !mod ? -ENOENT : mod->state != MODULE_LIVE ? -EBUSY : 0;
+    if (!*rc) mod->users++;
+    spin_unlock_irqrestore(&module_lock, flags);
+    return *rc ? 0 : mod;
