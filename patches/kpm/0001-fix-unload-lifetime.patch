diff --git a/kernel/base/hmem.c b/kernel/base/hmem.c
index 64ec496..faae104 100644
--- a/kernel/base/hmem.c
+++ b/kernel/base/hmem.c
@@ -6,6 +6,37 @@
 #include "hook.h"
 
 #include <stdint.h>
+#include <kallsyms.h>
+
+static uint32_t hook_registry_writer;
+static long (*hook_sleep_timeout)(long);
+static void hook_wait_progress(void)
+{
+    long (*sleep_fn)(long) = __atomic_load_n(&hook_sleep_timeout, __ATOMIC_ACQUIRE);
+    if (!sleep_fn) {
+        sleep_fn = (void *)kallsyms_lookup_name("schedule_timeout_uninterruptible");
+        __atomic_store_n(&hook_sleep_timeout, sleep_fn, __ATOMIC_RELEASE);
+    }
+    /* Sleeping only yields the CPU. The gate count, not a delay, proves exit. */
+    if (sleep_fn) sleep_fn(1);
+    else __asm__ __volatile__("yield" ::: "memory");
+}
+void hook_writer_lock(uint32_t *writer)
+{
+    while (__atomic_exchange_n(writer, 1, __ATOMIC_ACQUIRE)) hook_wait_progress();
+}
+void hook_writer_unlock(uint32_t *writer)
+{
+    __atomic_store_n(writer, 0, __ATOMIC_RELEASE);
+}
+void hook_registry_lock(void) { hook_writer_lock(&hook_registry_writer); }
+void hook_registry_unlock(void) { hook_writer_unlock(&hook_registry_writer); }
+void hook_callback_close(uint32_t *gate)
+{
+    __atomic_fetch_or(gate, HOOK_GATE_CLOSED, __ATOMIC_ACQ_REL);
+    while (__atomic_load_n(gate, __ATOMIC_ACQUIRE) & HOOK_GATE_USERS)
+        hook_wait_progress();
+}
 
 static uint64_t mem_region_start = 0;
 static uint64_t mem_region_end = 0;
